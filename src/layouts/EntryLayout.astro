---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  background?: string;
  issue?: string;
}

const { title, description, background, issue } = Astro.props;
const issueLabel = issue?.replace(/^https:\/\/github\.com\//, '').replace(/\/issues\//, '#');
---

<BaseLayout title={title} description={description}>
  <article class="prose mx-auto">
    <h1 class="text-[length:var(--fs-2xl)]">{title}</h1>
    {
      background && (
        <blockquote class="background">
          {background}
          {issue && (
            <>
              {' '}
              <a href={issue}>{issueLabel}</a>
            </>
          )}
        </blockquote>
      )
    }
    <p class="lead">{description}</p>
    <slot />
  </article>
</BaseLayout>
