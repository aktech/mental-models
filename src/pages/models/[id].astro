---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('models');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout title={entry.data.title} description={entry.data.description} background={entry.data.background} issue={entry.data.issue}>
  <Content />
</EntryLayout>
